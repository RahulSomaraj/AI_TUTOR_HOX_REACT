# Copy this file to `.env` and fill in the values for your environment.
# `.env` is git-ignored and must never be committed.

# Base URL of the backend REST API (no trailing slash), e.g. https://api.example.com/v1
VITE_API_BASE_URL=

# Axios request timeout in milliseconds. Optional — defaults to 30000 if unset.
VITE_API_TIMEOUT_MS=30000
